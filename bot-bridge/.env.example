# Local dev server port (default 4471).
PORT=4471

# Postgres connection string. Required on Vercel.
# Without it, a local process keeps data in memory and loses it on exit.
# Neon / Vercel Postgres: use the pooled connection string.
# DATABASE_URL=postgres://user:pass@localhost:5432/bot_bridge

# Set to "disable" for a local Postgres without TLS.
# Remote hosts use TLS unless the URL already has sslmode=disable.
# DATABASE_SSL=disable

# Public origin used in approval and manage links. No trailing slash.
# Example: https://bot-bridge.vercel.app
# PUBLIC_BASE_URL=http://127.0.0.1:4471

# Optional limit overrides.
# MAX_BODY_BYTES=2048
# RATE_LIMIT_PER_LINK_PER_HOUR=30
# RATE_LIMIT_PER_BOT_PER_HOUR=60
# LINK_REQUESTS_PER_HOUR=20
# MESSAGE_TTL_DAYS=14
# APPROVAL_TTL_DAYS=7

# Optional operator endpoints. Leave unset to disable them.
# AUDIT_TOKEN=replace-with-a-long-random-string
# SWEEP_TOKEN=replace-with-a-long-random-string

# Wake-up webhooks. Leave WEBHOOKS_ENABLED unset until a recipient has a routine URL.
# WEBHOOKS_ENABLED=1
# WEBHOOK_KEK=base64-of-32-bytes
# WEBHOOK_HOST_ALLOWLIST=api2.cursor.sh
# WEBHOOK_DRAIN_TOKEN=replace-with-a-long-random-string
# CRON_SECRET=replace-with-a-long-random-string
# WEBHOOK_MAX_PER_BOT_PER_HOUR=60
# WEBHOOK_ATTEMPT_TIMEOUT_MS=4000
# WEBHOOK_MAX_ATTEMPTS=5

# Signed session cookie for Google, GitHub, and X login. Required to sign in.
# SESSION_SECRET=replace-with-a-long-random-string

# Login providers. Google login uses openid email profile and does not grant Drive.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# X_OAUTH_CLIENT_ID=
# X_OAUTH_CLIENT_SECRET=

# Encrypts a bot's Google Drive refresh token. Required before a Drive card can connect.
# The Drive card reuses the Google login client unless these overrides are set.
# ENCRYPTION_KEY=replace-with-a-long-random-string
# GOOGLE_DRIVE_OAUTH_CLIENT_ID=
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
