# Copy to .env for local development only (.env is git-ignored). Never commit real values.
# Run locally with:  uv run --env-file .env uvicorn api.index:app --reload
# On Vercel, set the same names in Project Settings -> Environment Variables.

# ---- required -----------------------------------------------------------------

# Comma-separated name:role:sha256hex entries. Roles: viewer, editor, admin.
# Generate with: uv run python scripts/make_token.py grok-viewer viewer
API_TOKENS=

# One Google OAuth client of type "Web application" (Google Cloud -> Credentials).
# Redirect URIs: <APP_BASE_URL>/auth/callback (and http://localhost:8000/auth/callback locally).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Your own Google account (the only one that may sign in to the dashboard) and the bot account.
OWNER_EMAIL=
BOT_EMAIL=

# Public URL of the deployment, no trailing slash. Locally: http://localhost:8000
APP_BASE_URL=

# Generate both with: uv run python scripts/make_secrets.py
SESSION_SECRET=
ENCRYPTION_KEY=

# Upstash Redis (Vercel Marketplace). The integration may inject KV_REST_API_URL and
# KV_REST_API_TOKEN instead; either pair works. Leave empty locally to use an in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- optional -----------------------------------------------------------------

# Phase-1 fallback for the bot: a refresh token from scripts/bootstrap_oauth.py.
# If empty, the bot is connected from the dashboard (/connect-bot). If set, it wins.
GOOGLE_OAUTH_REFRESH_TOKEN=

# A folder that is always allowed in addition to what you tick in the dashboard.
# The ID at the end of the folder URL: https://drive.google.com/drive/folders/<ROOT_FOLDER_ID>
ROOT_FOLDER_ID=

# Google identity the server uses (only oauth_bot is implemented).
AUTH_MODE=oauth_bot

# Limits (defaults shown).
# MAX_BYTES=5242880
# MAX_CHARS=100000
# SCOPE_CACHE_TTL=60
# ALLOWLIST_CACHE_TTL=2
