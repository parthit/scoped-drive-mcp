{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "src/scoped_drive_mcp/templates/**",
      "excludeFiles": "{tests/**,docs/**,scripts/**,.venv/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
